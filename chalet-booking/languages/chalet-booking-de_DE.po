msgstr "%1$s: %2$d × %3$s"

msgid "Rabais séjour d’une semaine ou plus (%s %%)"
msgstr "Rabatt ab einer Woche Aufenthalt (%s %%)"

msgid "Taxe de séjour : %1$d adulte(s) × %2$d nuit(s) × %3$s"
msgstr "Kurtaxe: %1$d Erwachsene(r) × %2$d Nacht/Nächte × %3$s"

msgid "Demande refusée."
msgstr "Anfrage abgelehnt."

msgid "Trop de demandes. Merci de réessayer plus tard ou de nous contacter directement."
msgstr "Zu viele Anfragen. Bitte versuchen Sie es später erneut oder kontaktieren Sie uns direkt."

msgid "Merci d’indiquer votre nom, un e-mail valide et un téléphone."
msgstr "Bitte geben Sie Ihren Namen, eine gültige E-Mail-Adresse und eine Telefonnummer an."

msgid "Merci d’accepter les conditions de location."
msgstr "Bitte akzeptieren Sie die Mietbedingungen."

msgid "Le service est momentanément occupé, veuillez réessayer."
msgstr "Der Dienst ist vorübergehend ausgelastet, bitte versuchen Sie es erneut."

msgid "Une erreur est survenue, merci de réessayer."
msgstr "Es ist ein Fehler aufgetreten, bitte versuchen Sie es erneut."

msgid "Merci ! Votre demande de réservation a bien été envoyée. Vous allez recevoir un e-mail récapitulatif et nous vous confirmerons la réservation rapidement."
msgstr "Vielen Dank! Ihre Buchungsanfrage wurde gesendet. Sie erhalten eine Zusammenfassung per E-Mail und wir bestätigen Ihre Buchung in Kürze."


msgid "{chalet} — Demande de réservation reçue"
msgstr "{chalet} — Buchungsanfrage erhalten"

msgid "Bonjour {name},\n\nMerci pour votre demande. Nous la vérifions et revenons vers vous rapidement pour la confirmer.\n\n{summary}\n\nMeilleures salutations,\n{chalet}"
msgstr "Guten Tag {name},\n\nvielen Dank für Ihre Anfrage. Wir prüfen sie und melden uns in Kürze mit einer Bestätigung.\n\n{summary}\n\nFreundliche Grüße\n{chalet}"

msgid "{chalet} — Votre réservation est confirmée"
msgstr "{chalet} — Ihre Buchung ist bestätigt"

msgid "Bonjour {name},\n\nNous avons le plaisir de confirmer votre séjour à Verbier.\n\n{summary}\n\nModalités de paiement :\n{payment}\n\nAu plaisir de vous accueillir !\n{chalet}"
msgstr "Guten Tag {name},\n\nwir freuen uns, Ihren Aufenthalt in Verbier zu bestätigen.\n\n{summary}\n\nZahlungsbedingungen:\n{payment}\n\nWir freuen uns auf Ihren Besuch!\n{chalet}"

msgid "{chalet} — Votre demande de réservation"
msgstr "{chalet} — Ihre Buchungsanfrage"

msgid "Bonjour {name},\n\nNous sommes désolés, nous ne pouvons pas donner suite à votre demande pour les dates suivantes :\n\n{summary}\n\nN’hésitez pas à nous contacter pour d’autres dates.\n{chalet}"
msgstr "Guten Tag {name},\n\nleider können wir Ihre Anfrage für die folgenden Daten nicht annehmen:\n\n{summary}\n\nKontaktieren Sie uns gerne für andere Daten.\n{chalet}"

msgid "Arrivée : %1$s dès %2$s"
msgstr "Anreise: %1$s ab %2$s"

msgid "Départ : %1$s avant %2$s"
msgstr "Abreise: %1$s bis %2$s"


msgstr "(mensaje de ejemplo)"

msgid "Tarif standard"
msgstr "Tarifa estándar"

msgid "%1$s : %2$d × %3$s"
msgstr "%1$s: %2$d × %3$s"

msgid "Rabais séjour d’une semaine ou plus (%s %%)"
msgstr "Descuento por estancias de una semana o más (%s %%)"

msgid "Taxe de séjour : %1$d adulte(s) × %2$d nuit(s) × %3$s"
msgstr "Tasa turística: %1$d adulto(s) × %2$d noche(s) × %3$s"

msgid "Demande refusée."
msgstr "Solicitud rechazada."

msgid "Trop de demandes. Merci de réessayer plus tard ou de nous contacter directement."
msgstr "Demasiadas solicitudes. Inténtelo más tarde o contáctenos directamente."

msgid "Merci d’indiquer votre nom, un e-mail valide et un téléphone."
msgstr "Indique su nombre, un correo electrónico válido y un teléfono."

msgid "Merci d’accepter les conditions de location."
msgstr "Acepte las condiciones de alquiler."

msgid "Le service est momentanément occupé, veuillez réessayer."
msgstr "El servicio está ocupado en este momento, inténtelo de nuevo."

msgid "Une erreur est survenue, merci de réessayer."
msgstr "Se ha producido un error, inténtelo de nuevo."

msgid "Merci ! Votre demande de réservation a bien été envoyée. Vous allez recevoir un e-mail récapitulatif et nous vous confirmerons la réservation rapidement."
msgstr "¡Gracias! Su solicitud de reserva se ha enviado. Recibirá un resumen por correo electrónico y confirmaremos su reserva en breve."

